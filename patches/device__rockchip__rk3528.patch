--- a/BoardConfig.mk
+++ b/BoardConfig.mk
@@ -41,7 +41,8 @@ PRODUCT_KERNEL_DTS ?= rk3528-evb1-ddr4-v10
 PRODUCT_KERNEL_CONFIG ?= rockchip_defconfig
 
 # used for fstab_generator, sdmmc controller address
-# PRODUCT_BOOT_DEVICE := ffbf0000.mmc
+# eMMC controller per stock cmdline (androidboot.boot_devices=ffbf0000.mmc)
+PRODUCT_BOOT_DEVICE := ffbf0000.mmc
 PRODUCT_SDMMC_DEVICE := ffc30000.mmc
 
 #BOARD_SUPER_PARTITION_SIZE := 4294967296
@@ -51,8 +52,17 @@ PRODUCT_SDMMC_DEVICE := ffc30000.mmc
 # Disable emulator for "make dist" until there is a 64-bit qemu kernel
 BUILD_EMULATOR := false
 TARGET_BOARD_PLATFORM := rk3528
+BOARD_PREBUILT_DTBIMAGE_DIR := $(TARGET_DEVICE_DIR)/dtb
+# Real partition sizes from box partition table (mmcblk0p7/8 = 64MB/96MB)
+BOARD_BOOTIMAGE_PARTITION_SIZE := 67108864
+# Box super partition real size: 2457600 * 1KB blocks (from partition table)
+BOARD_SUPER_PARTITION_SIZE := 2516582400
+BOARD_RECOVERYIMAGE_PARTITION_SIZE := 100663296
 TARGET_BOARD_PLATFORM_GPU := mali450
 TARGET_RK_GRALLOC_VERSION := 1
+# 64-bit GPU stack: arm64 Mali-450 closed blob from RK vendor SDK
+# (vendor/rockchip/common/gpu/Mali450/lib/arm64/libGLES_mali.so)
+BOARD_USES_GRALLOC4 := true
 CAMERA_WITHOUT_GRALLOC4 := true
 BOARD_USE_DRM := true
 
@@ -65,6 +75,13 @@ BOARD_OVERRIDE_RS_CPU_VARIANT_64 := cortex-a53
 TARGET_USES_64_BIT_BCMDHD := true
 TARGET_USES_64_BIT_BINDER := true
 
+# Full 64-bit userspace: run media/audio/DRM services in 64-bit mode.
+# (AOSP defaults them to prefer32 for legacy 32-bit HAL compat; our vendor
+# HALs all ship arm64 builds, so switch everything to 64-bit.)
+TARGET_DYNAMIC_64_32_MEDIASERVER := false
+TARGET_DYNAMIC_64_32_DRMSERVER := false
+TARGET_ENABLE_MEDIADRM_64 := true
+
 # HACK: Build apps as 64b for volantis_64_only
 ifneq (,$(filter ro.zygote=zygote64, $(PRODUCT_DEFAULT_PROPERTY_OVERRIDES)))
 TARGET_PREFER_32_BIT_APPS :=
@@ -131,7 +148,7 @@ BUILD_BROKEN_USES_BUILD_HOST_SHARED_LIBRARY := true
 BUILD_BROKEN_USES_BUILD_HOST_STATIC_LIBRARY := true
 
 BOARD_SHOW_HDMI_SETTING ?= true
-BOARD_SUPPORT_HDMI_CEC := false
+BOARD_SUPPORT_HDMI_CEC := true
 
 # for dynamaic afbc target 
 BOARD_HS_DYNAMIC_AFBC_TARGET := false
