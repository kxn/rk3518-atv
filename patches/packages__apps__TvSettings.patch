+            android.util.Log.i("BluetoothPairingRequest", "Automatically confirmed Bluetooth remote"
+                    + " attempt=" + attempt);
+            pending.finish();
+            return;
+        }
+        if (attempt < 8 && (recognized || name == null || name.isEmpty())) {
+            new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(
+                    () -> confirmWhenReady(context, intent, device, type, known, pending,
