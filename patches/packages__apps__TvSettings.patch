+    private static void confirmWhenReady(Context context, Intent intent, BluetoothDevice device,
+            int type, android.content.SharedPreferences known, PendingResult pending, int attempt) {
+        String name = device.getName();
+        boolean named = BluetoothDevicePairer.isBoxRemoteName(name)
+                || BluetoothDevicePairer.isBoxRemoteName(intent.getStringExtra(BluetoothDevice.EXTRA_NAME));
+        if (named) known.edit().putBoolean(device.getAddress(), true).apply();
+        boolean recognized = named || known.getBoolean(device.getAddress(), false);
+        if (device.getBondState() == BluetoothDevice.BOND_BONDED) {
+            pending.finish();
+            return;
