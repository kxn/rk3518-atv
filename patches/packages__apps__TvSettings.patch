     public static final String TAG = "BluetoothDevicePairer";
+
+    // This box ships with a remote that cannot operate a confirmation dialog
+    // before bonding. Restrict unattended pairing to its advertised name.
+    public static boolean isBoxRemote(BluetoothDevice device) {
+        return device != null && isBoxRemoteName(device.getName());
+    }
+    public static boolean isBoxRemoteName(String name) {
+        return name != null && "Bluetooth remote".equalsIgnoreCase(name.replace("\u0000", "").trim());
+    }
+
+    private android.bluetooth.le.BluetoothLeScanner mRemoteScanner;
+    private final android.bluetooth.le.ScanCallback mRemoteScanCallback =
+            new android.bluetooth.le.ScanCallback() {
+        @Override public void onScanResult(int callbackType, android.bluetooth.le.ScanResult result) {
+            BluetoothDevice device = result.getDevice();
+            String advertisedName = result.getScanRecord() == null ? null
+                    : result.getScanRecord().getDeviceName();
+            if (mStatus != STATUS_SCANNING
+                    || !(isBoxRemote(device) || isBoxRemoteName(advertisedName))) return;
+            if (device.getBondState() != BluetoothDevice.BOND_NONE) return;
+            mContext.createDeviceProtectedStorageContext()
+                    .getSharedPreferences("box_remotes", Context.MODE_PRIVATE)
+                    .edit().putBoolean(device.getAddress(), true).apply();
+            Log.i(TAG, "Found Bluetooth remote via BLE; starting pairing");
+            openBoxRemoteSetup();
+        }
+        @Override public void onScanFailed(int errorCode) {
+            Log.e(TAG, "Remote BLE scan failed: " + errorCode);
+        }
+    };
+
+    private void startRemoteLeScan(BluetoothAdapter adapter) {
+        if (mRemoteScanner != null) return;
+        mRemoteScanner = adapter.getBluetoothLeScanner();
+        if (mRemoteScanner == null) return;
+        try {
+            mRemoteScanner.startScan(null, new android.bluetooth.le.ScanSettings.Builder()
+                    .setScanMode(android.bluetooth.le.ScanSettings.SCAN_MODE_LOW_LATENCY).build(),
+                    mRemoteScanCallback);
+            Log.i(TAG, "Started BLE remote scan");
+        } catch (IllegalStateException e) {
+            mRemoteScanner = null;
+            Log.w(TAG, "Bluetooth changed while starting remote scan", e);
+        }
+    }
+
+    private void stopRemoteLeScan() {
+        android.bluetooth.le.BluetoothLeScanner scanner = mRemoteScanner;
+        mRemoteScanner = null;
+        if (scanner != null) {
+            try { scanner.stopScan(mRemoteScanCallback); }
+            catch (IllegalStateException e) {
+                Log.w(TAG, "Bluetooth changed while stopping remote scan", e);
+            }
+        }
+    }
+
+    private void openBoxRemoteSetup() {
+        // The independent service owns every remote bond/HID operation.
+        // Dispose of this page with no target, so its cancellation cannot unpair it.
+        stopScanning();
+        mHandler.removeCallbacksAndMessages(null);
+        mTarget = null;
+        setStatus(STATUS_NONE);
+        android.content.Intent setup = new android.content.Intent().setComponent(
+                new android.content.ComponentName("com.rockchip.remotesetup",
+                        "com.rockchip.remotesetup.PairActivity"));
+        setup.addFlags(android.content.Intent.FLAG_ACTIVITY_NEW_TASK);
+        try {
+            mContext.startActivity(setup);
+            if (mContext instanceof android.app.Activity) {
+                ((android.app.Activity) mContext).finish();
+            }
+        } catch (android.content.ActivityNotFoundException | SecurityException e) {
+            Log.e(TAG, "Independent remote setup unavailable", e);
+            setStatus(STATUS_ERROR);
+        }
+    }
     public static final int STATUS_ERROR = -1;
     public static final int STATUS_NONE = 0;
     public static final int STATUS_SCANNING = 1;
