+package rockit_hw_service
+
+import (
+	"android/soong/android"
+	"android/soong/cc"
+	"fmt"
+)
+
+func init() {
+	fmt.Println("cc_rockit_hw_service want to conditional Compile")
+	android.RegisterModuleType("cc_rockit_hw_service", DefaultsFactory)
+}
+
+func DefaultsFactory() android.Module {
+	module := cc.DefaultsFactory()
+	android.AddLoadHook(module, Defaults)
+	return module
+}
+
+func Defaults(ctx android.LoadHookContext) {
+	// platform version is 11/12/13...
+	platformVersionInt := ctx.AConfig().PlatformSdkVersion().FinalOrFutureInt()
+	fmt.Printf("platformVersion android %d\n", platformVersionInt)
+
+	type props struct {
+		Shared_libs []string
+	}
+
+	p := &props{}
+	p.Shared_libs = getSharedLibs(ctx, platformVersionInt)
+
+	ctx.AppendProperties(p)
+}
+
+func getSharedLibs(ctx android.BaseContext, platformVersionInt int) []string {
+	var libs []string
+
+	if platformVersionInt >= 11 {
+		libs = append(libs, "libavservices_minijail")
+	} else {
+		libs = append(libs, "libavservices_minijail_vendor")
+	}
+
+	return libs
+}
