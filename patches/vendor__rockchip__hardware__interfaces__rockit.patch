+func getHeaders(ctx android.BaseContext, platformVersionInt int) []string {
+	var headers []string
+
+	currentDir := getCurrentAbsolutePath()
+	sourceFile := currentDir
+	if platformVersionInt > 10 {
+		sourceFile += "/include/RockitMetadataRetrieverComm.h"
+	} else {
+		sourceFile += "/include/RockitMetadataRetriever10.h"
+	}
+	destinationFile := currentDir + "/include/RockitMetadataRetriever.h"
+
+	_, err := os.Lstat(destinationFile)
+	if !os.IsNotExist(err) {
+		os.Remove(destinationFile)
+	}
+
+	err = os.Symlink(sourceFile, destinationFile)
+	if err != nil {
+		fmt.Println("Link Error: ", err)
+	}
+
+	if platformVersionInt >= 12 {
+		headers = append(headers, "libhardware_rockchip_headers")
+	}
+
+	if platformVersionInt >= 11 {
+		headers = append(headers, "libmediametrics_headers")
+	}
+
+	return headers
 }
 
